# Copy to .env. Nothing here is required for Quickstart A (zero keys).

# --- Providers -----------------------------------------------------------------
# scripted = canned fixtures, no key (Quickstart A) | anthropic (Quickstart B) | openai
ADSMITH_LLM_PROVIDER=scripted
# mock = local ffmpeg/Pillow placeholders, no key | fal = real generation via fal.ai
ADSMITH_MEDIA_PROVIDER=mock
# auto = mock critic with mock media, LLM vision critic with real media | mock | llm
ADSMITH_QA_MODE=auto

# --- Models (IDs live in config/models.toml; never in code) ----------------------
# fast | balanced | quality  (empty = default_profile from models.toml)
ADSMITH_MODEL_PROFILE=balanced
# Per-node override example:
# ADSMITH_MODEL__STORYBOARD=claude-opus-5-5
# fal model keys from config/models.toml (empty = catalog default)
# ADSMITH_FAL_VIDEO_MODEL=kling_v3_pro
# ADSMITH_FAL_IMAGE_MODEL=flux_dev

# --- Secrets (standard names) ----------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FAL_KEY=

# --- Run behaviour ---------------------------------------------------------------
ADSMITH_ASPECT_RATIO=9:16
ADSMITH_TARGET_DURATION_S=15
ADSMITH_BUDGET_USD=10
ADSMITH_MAX_ATTEMPTS_PER_SCENE=6
ADSMITH_MAX_TOTAL_ATTEMPTS=40
ADSMITH_QA_THRESHOLD=0.7
ADSMITH_SCENE_CONCURRENCY=3
ADSMITH_CHAOS=false
ADSMITH_MOCK_LATENCY_S=1.5

# --- Paths & logging -------------------------------------------------------------
# ADSMITH_DATA_DIR=./data
ADSMITH_LOG_FORMAT=console
ADSMITH_LOG_LEVEL=INFO
